# The traveler steps off the ferry and meets the guide on the pier.
# Exercises dialogue, name entry, choices that record their answer, panels,
# camera, actors in parallel, a race, ambient sound and a name token.

event harbor_arrival skippable
	lock player
	fade out 0
	music play tide_theme
	ambient play harbor_gulls
	camera cut pier_wide
	show traveler
	fade in 1.5

	panel show p1 camera ferry_ramp layout top_left
	panel show p2 camera guide_close layout top_right
	together
		move traveler to pier_end speed 1.5
		sequence
			anim guide wave
			face guide traveler
		end
		camera move pier_follow 2.0
	end
	panel clear

	say guide @harbor.welcome as cheerful
	name entry traveler
	say traveler @harbor.crossing
	narrate @harbor.gulls

	ask @harbor.satchel_question into harbor.satchel_carried
	yes
		say guide @harbor.satchel_light as strained
	no
		say guide @harbor.satchel_refused as amused
	end

	choice @harbor.first_stop_prompt into harbor.first_stop
	option @harbor.option_market
		say guide @harbor.market_hint
	option @harbor.option_lighthouse
		say guide @harbor.lighthouse_hint
	option @harbor.option_rest
		say guide @harbor.inn_hint
	end

	# The ferry pulls away; the camera follows it until the guide moves on.
	race
		camera move ferry_departing 4.0
		wait 2.5
	end

	if not harbor.met_guide
		give harbor_map
		party add guide
		set harbor.met_guide
	end
	ambient stop
	unlock player
end
