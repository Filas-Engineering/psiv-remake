# The keeper's lighthouse is overrun. Exercises battles with an opening,
# warps, a free rest, screen effects, audio fades, party changes and a
# skippable scene inside an unskippable one.

event lighthouse_ambush unskippable
	lock player
	call lighthouse_alarm

	battle lamp_room_moths opening enemy_first
	win
		say keeper @lighthouse.light_safe
		give brass_key
		rest
		set lighthouse.cleared
	lose
		narrate @lighthouse.wake_on_shore
		warp harbor pier_end
	flee
		say guide @lighthouse.more_oil as worried
		clear lighthouse.cleared
	end

	if lighthouse.cleared
		party remove guide
		say guide @lighthouse.stay_and_help as resolute
		anim keeper bow loop
		wait 0.5
	end
	music stop
	camera move lamp_overlook 3.0
	fade out 1.0
	unlock player
end

# Skipping this returns to lighthouse_ambush right before the battle.
event lighthouse_alarm skippable
	warp lighthouse_base door_inside
	music play keeper_hum
	panel show p1 camera stair_spiral layout full
	shake 0.8 strength 0.4
	sound glass_crack
	panel hide p1
	say keeper @lighthouse.moths_nesting as alarmed
	music fade 1.0
end
