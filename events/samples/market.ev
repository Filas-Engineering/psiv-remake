# A vendor haggles with the traveler. Exercises variables (two of them
# local to the event), conditions, loops, labels, calls, a shop and
# background actions.

event market_haggle unskippable
	camera cut stall_front
	sound bell_chime
	move vendor to 4.0 0.0 -2.5 nowait
	move traveler to stall_counter nowait
	sync

	say vendor @market.vendor_greeting as beaming
	var market.offer = 30
	var market.rounds = 0

	while market.offer > 18 and market.rounds < 3
		call market_counter_offer
	end

	if market.offer <= 18 or market.patience == 0
		say vendor @market.hard_bargain as defeated
	else if market.offer < 25
		say vendor @market.final_price
	else
		say vendor @market.prices_are_prices
	end

	if harbor.met_guide and not market.bought_lantern
		call market_buy_lantern
	end

	if market.bought_lantern
		goto farewell
	end
	say vendor @market.mind_the_crates
	label farewell
	hide vendor
	narrate @market.closing_narration
end

event market_counter_offer unskippable
	say traveler @market.do_better
	var market.offer -= 5
	var market.rounds += 1
	anim vendor shrug
	if market.rounds >= 3
		var market.patience = 0
		return
	end
	say vendor @market.little_better
end

event market_buy_lantern unskippable
	choice
	option @market.option_buy
		take coin_pouch
		give lantern_oil 2
		set market.bought_lantern
	option @market.option_browse
		shop vendor_stall
	option @market.option_not_today
		say vendor @market.come_back
	end
end
