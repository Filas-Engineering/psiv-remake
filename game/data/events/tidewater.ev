# Tidewater Landing: the ferry leaves the fighter at a quiet harbor town
# whose guide wants someone to look into a bell that rings at night.

event tidewater_arrival skippable
	lock player
	fade in 1.0
	narrate @tidewater.arrival.ferry
	say dockhand @tidewater.arrival.ropes
	set tidewater.arrived
	unlock player
end

event tidewater_guide unskippable
	lock player
	face guide fighter
	if not tidewater.met_guide
		say guide @tidewater.guide.bell
		ask @tidewater.guide.ask
		yes
			say guide @tidewater.guide.apprentices
			party add mystic
			party add medic
			give tonic 2
			set tidewater.met_guide
		no
			say guide @tidewater.guide.later
		end
	else if cove.warden_beaten
		say guide @tidewater.guide.quiet
		set tidewater.reported
	else
		choice @tidewater.guide.topics
		option @tidewater.guide.topic_bell
			say guide @tidewater.guide.about_bell
		option @tidewater.guide.topic_reeds
			say guide @tidewater.guide.about_reeds
		end
	end
	unlock player
end

# A guild job: the dockhand lost a cache of supplies in the reeds.
event tidewater_dockhand unskippable
	lock player
	if job.lost_cache.done
		say dockhand @tidewater.dockhand.thanks_again
	else if chest.reed_cache and job.lost_cache.accepted
		say dockhand @tidewater.dockhand.found
		give clear_gel 2
		set job.lost_cache.done
	else if job.lost_cache.accepted
		say dockhand @tidewater.dockhand.reminder
	else
		say dockhand @tidewater.dockhand.request
		ask @tidewater.dockhand.ask into job.lost_cache.accepted
		yes
			say dockhand @tidewater.dockhand.accepted
		no
			say dockhand @tidewater.dockhand.declined
		end
	end
	unlock player
end
