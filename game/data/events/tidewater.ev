# Tidewater Landing: the ferry leaves the fighter at a quiet harbor town
# whose guide wants someone to look into a bell that rings at night.

event tidewater_arrival skippable
	lock player
	fade in 1.0
	narrate "The ferry bumps against the pilings of Tidewater Landing."
	say dockhand "Mind the ropes. The guide waits by the noticeboard."
	set tidewater.arrived
	unlock player
on skip
	set tidewater.arrived
	fade in 0
	unlock player
end

event tidewater_guide unskippable
	lock player
	face guide fighter
	if not tidewater.met_guide
		say guide "You came about the bell? It rings every night at Bell Cove, east past the reeds."
		ask "Will you look into it?"
		yes
			say guide "Then take my apprentices. One knows a spark or two, the other knows bandages."
			party add mystic
			party add medic
			give tonic 2
			set tidewater.met_guide
		no
			say guide "Come back when you change your mind."
		end
	else if cove.warden_beaten
		say guide "Quiet nights again. The whole harbor owes you a supper."
	else
		choice "Ask about..."
		option "The bell"
			say guide "Something made of brass guards it. Rest at the inn before you go."
		option "The reeds"
			say guide "Small pests, mostly. Walk around them if you can."
		end
	end
	unlock player
end
