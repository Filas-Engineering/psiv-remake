# Bell Cove: the boss guards the bell. Losing sends the party back to the
# inn, so the fight can be tried again. A campfire by the gate lets the
# party rest and save before the fight.

event cove_bell unskippable
	lock player
	narrate @cove.bell.frame
	say mystic @cove.bell.warden as mystic_worried
	set cove.warden_seen
	music play brass_alarm
	battle warden
	win
		say mystic @cove.bell.won
		give spark_flask 1
		set cove.warden_beaten
	lose
		narrate @cove.bell.lost
		warp tidewater inn_front
		set cove.warden_lost
	end
	music stop
	unlock player
end

# Fires from a flag hook once the warden is down and control is back. It is
# the end of the story, so it writes the clear-data record.
event cove_quiet skippable
	narrate @cove.quiet.tide
	set cove.quiet_seen
end

event cove_campfire unskippable
	lock player
	narrate @cove.campfire.embers
	ask @cove.campfire.ask
	yes
		rest cove_camp
		narrate @cove.campfire.rested
		narrate @cove.campfire.journal
		save prompt
	no
		narrate @cove.campfire.declined
	end
	unlock player
end
