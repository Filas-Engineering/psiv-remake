{
	"version": 1,
	"windows": [
		{"name": "members", "visible": "view == 'members'", "x": "area_x", "y": "area_y", "w": "area_w", "h": "area_h", "elements": [
			{"type": "list", "items": "members", "state": "list"}
		]},
		{"name": "abilities", "visible": "view == 'list'", "x": "area_x", "y": "area_y", "w": "area_w", "h": "area_h", "elements": [
			{"type": "text", "value": "name", "x": 14, "color": "accent"},
			{"type": "text", "visible": "len(abilities) == 0", "key": "ui.status.no_abilities", "x": 14, "y": "t(40)", "color": "dim"},
			{"type": "group", "visible": "len(abilities) > 0", "y": "t(40)", "elements": [
				{"type": "text", "key": "ui.status.kind", "x": "(picking ? cw * 3 / 5 : cw) * 45 / 100", "style": "small_dim"},
				{"type": "text", "key": "ui.status.cost", "x": "(picking ? cw * 3 / 5 : cw) * 62 / 100", "style": "small_dim"},
				{"type": "text", "key": "ui.status.uses", "x": "(picking ? cw * 3 / 5 : cw) * 76 / 100", "style": "small_dim"},
				{"type": "list", "items": "abilities", "state": "sub_list", "active": "!picking", "y": "t(28)", "w": "picking ? cw * 3 / 5 : cw",
					"h": "ch - t(40) - t(28) - t(56)", "row_height": "t(30)", "row": [
					{"type": "fill", "visible": "selected", "x": -6, "y": -3, "w": "(picking ? cw * 3 / 5 : cw) - 14", "h": "t(28)", "color": "row"},
					{"type": "pointer", "visible": "selected", "x": -4, "y": "(t(28) - 8) / 2 - 6"},
					{"type": "text", "value": "label", "x": 14, "max_width": "(picking ? cw * 3 / 5 : cw) * 45 / 100 - 30", "color": "!usable ? 'dim' : selected ? 'accent' : 'text'"},
					{"type": "text", "value": "kind", "x": "(picking ? cw * 3 / 5 : cw) * 45 / 100", "style": "small_dim"},
					{"type": "text", "value": "cost", "x": "(picking ? cw * 3 / 5 : cw) * 62 / 100", "style": "small"},
					{"type": "text", "value": "uses", "x": "(picking ? cw * 3 / 5 : cw) * 76 / 100", "style": "small"}
				]}
			]},
			{"type": "group", "visible": "len(abilities) > 0", "y": "ch - t(56)", "elements": [
				{"type": "fill", "w": "(picking ? cw * 3 / 5 : cw) - 14", "h": 1, "color": "panel_edge", "alpha": 0.4},
				{"type": "text", "visible": "description != ''", "value": "description", "x": 14, "y": "t(8)", "wrap": true, "max_width": "(picking ? cw * 3 / 5 : cw) - 40", "lines": 2, "line_height": "t(22)", "style": "small"},
				{"type": "text", "visible": "description == ''", "key": "ui.common.no_description", "x": 14, "y": "t(8)", "wrap": true, "max_width": "(picking ? cw * 3 / 5 : cw) - 40", "lines": 2, "line_height": "t(22)", "style": "small_dim"}
			]},
			{"type": "text", "visible": "len(abilities) > 0 && !picking", "key": "ui.status.usable_here", "w": "cw - 20", "align": "right", "style": "small_dim"},
			{"type": "group", "visible": "len(abilities) > 0 && picking", "x": "cw * 3 / 5 + 20", "y": "t(40)", "elements": [
				{"type": "text", "key": "ui.menu.use_on_whom", "args": ["target_name"], "color": "accent"},
				{"type": "list", "items": "targets", "state": "target_list", "y": "t(28) + t(12)", "w": "cw - cw * 3 / 5 - 20", "h": "ch - t(40) - t(28) - t(12)"}
			]}
		]}
	]
}
