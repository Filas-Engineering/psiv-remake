			{"type": "text", "value": "hint", "max_width": "W - 32", "w": "W", "align": "center", "y": 6, "style": "small_dim"}
		]},
		{"name": "result", "visible": "phase == 'ended'", "x": "(W - w) / 2", "y": "max(24, (strip.y - h) / 2)", "w": 640, "h": "84 + len(result_lines) * 30", "frame": "battle",
