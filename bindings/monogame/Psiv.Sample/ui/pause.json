{
	"version": 1,
	"windows": [
		{"name": "scene", "elements": [{"type": "slot", "slot": "scene"}]},
		{"name": "hud", "visible": "hud", "elements": [
			{"type": "plate", "value": "area", "x": 16, "y": 12, "scaled": false},
			{"type": "plate", "value": "status", "x": "W - measure_unscaled(status, size_small) - 40", "y": 12, "color": "text", "scaled": false}
		]},
		{"name": "dim", "elements": [{"type": "fill", "w": "W", "h": "H", "color": "black", "alpha": 0.55}]},
		{"name": "box", "anchor": "center", "w": "min(t(size_body * 18), W - 16)", "h": "t(size_body * 2) + len(rows) * t(size_body + 12) + t(size_body)", "frame": "panel",
			"title": "ui.pause.title", "elements": [
			{"type": "rows", "items": "rows", "selected": "cursor", "size": "size_body", "x": "t(size_body * 2)", "y": "t(size_body + 14)", "w": "cw - t(size_body * 7 / 2)",
				"row_height": "t(size_body + 12)", "height": "t(size_body + 8)"}
		]},
		{"name": "hint", "x": 0, "y": "H - t(size_small + 14)", "h": "t(size_small + 14)", "elements": [
			{"type": "fill", "w": "W", "h": "t(size_small + 14)", "color": "black", "alpha": 0.6},
			{"type": "text", "value": "hint", "max_width": "W - 32", "w": "W", "align": "center", "y": "t(size_small / 3)", "style": "small_dim"}
		]}
	]
}
