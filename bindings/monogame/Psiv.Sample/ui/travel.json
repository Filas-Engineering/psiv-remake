{
	"version": 1,
	"windows": [
		{"name": "backdrop", "elements": [{"type": "slot", "slot": "backdrop"}]},
		{"name": "box", "x": "(W - 640) / 2 - 24", "y": "max(96, (H - (h - 64)) / 2 - 60) - 40", "w": 688, "h": "t(40) + min(len(labels), 8) * t(30) + t(8) + t(56) + 64",
			"frame": "panel", "title": {"value": "title"}, "elements": [
			{"type": "text", "value": "question", "x": 24, "y": 40, "color": "accent"},
			{"type": "list", "items": "labels", "state": "list", "x": 24, "y": "40 + t(40)", "w": 640, "h": "min(len(labels), 8) * t(30) + t(8)"},
			{"type": "fill", "x": 24, "y": "ch - 24 - t(56)", "w": 626, "h": 1, "color": "panel_edge", "alpha": 0.4},
			{"type": "text", "value": "description", "x": 38, "y": "ch - 24 - t(56) + t(8)", "wrap": true, "max_width": 600, "lines": 2, "line_height": "t(22)",
				"style": "small", "color": "description_missing ? 'dim' : 'text'"}
		]},
		{"name": "hint", "x": 0, "y": "H - t(30)", "h": "t(30)", "elements": [
			{"type": "fill", "w": "W", "h": "t(30)", "color": "black", "alpha": 0.6},
			{"type": "text", "value": "hint", "max_width": "W - 32", "w": "W", "align": "center", "y": "t(5)", "style": "small_dim"}
		]},
		{"name": "toasts", "elements": [{"type": "slot", "slot": "toasts", "x": 48, "y": "H - 92"}]}
	]
}
