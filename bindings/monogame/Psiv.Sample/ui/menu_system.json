{
	"version": 1,
	"windows": [
		{"name": "page", "x": "area_x", "y": "area_y", "w": "area_w", "h": "area_h", "elements": [
			{"type": "list", "items": "rows", "state": "list", "w": "cw", "h": "ch - t(56)", "row_height": "t(30)", "row": [
				{"type": "fill", "visible": "selected", "x": -6, "y": -3, "w": "cw - 14", "h": "t(28)", "color": "row"},
				{"type": "pointer", "visible": "selected", "x": -4, "y": "(t(28) - 8) / 2 - 6"},
				{"type": "text", "value": "label", "x": 14, "color": "selected ? 'accent' : 'text'"},
				{"type": "text", "value": "value", "x": "cw * 55 / 100", "color": "selected ? 'accent' : 'text'"}
			]},
			{"type": "text", "value": "description", "x": 14, "y": "ch - t(56) + t(8)", "wrap": true, "max_width": "cw - 40", "lines": 2, "line_height": "t(22)", "style": "small_dim"}
		]}
	]
}
