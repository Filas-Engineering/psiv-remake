{
	"version": 1,
	"windows": [
		{"name": "hud", "visible": "hud", "elements": [
			{"type": "plate", "value": "area", "x": 16, "y": 12, "scaled": false},
			{"type": "plate", "value": "status", "x": "W - measure_unscaled(status, size_small) - 40", "y": 12, "color": "text", "scaled": false}
		]},
		{"name": "banner", "visible": "banner_visible", "anchor": "top", "y": "70 - banner_drop", "h": 86, "frame": "panel", "opacity": "banner_alpha",
			"w": "max(measure_unscaled(banner_title, size_title), measure_unscaled(banner_kind, size_small)) + 80", "elements": [
			{"type": "text", "value": "banner_kind", "x": "-banner.x", "w": "W", "align": "center", "y": 14, "style": "small_dim", "alpha": "banner_alpha", "scaled": false},
			{"type": "text", "value": "banner_title", "x": "-banner.x", "w": "W", "align": "center", "y": 38, "style": "title", "alpha": "banner_alpha", "scaled": false}
		]},
		{"name": "toasts", "elements": [
			{"type": "repeater", "items": "toasts", "x": 16, "y": "H - 40 - 38", "dy": -38, "template": [
				{"type": "box", "name": "toast", "w": "width", "h": 32, "opacity": "box_alpha", "scaled": false},
				{"type": "text", "value": "text", "x": 14, "y": 7, "style": "small", "alpha": "alpha", "scaled": false}
			]}
		]},
		{"name": "prompt", "visible": "prompt_visible", "x": "(W - w) / 2", "y": "H - t(30) - 46", "w": "measure_unscaled(prompt_key + '  ' + prompt_text, size_small) + 24",
			"h": 28, "elements": [
			{"type": "plate", "value": "prompt_key + '  ' + prompt_text", "color": "accent", "alpha": "prompt_ready ? 1 : 0.5", "scaled": false}
		]},
		{"name": "hint", "x": 0, "y": "H - t(30)", "h": "t(30)", "elements": [
			{"type": "fill", "w": "W", "h": "t(30)", "color": "black", "alpha": 0.6, "scaled": false},
			{"type": "text", "value": "hint", "max_width": "W - 32", "w": "W", "align": "center", "y": "t(5)", "style": "small_dim", "scaled": false}
		]}
	]
}
