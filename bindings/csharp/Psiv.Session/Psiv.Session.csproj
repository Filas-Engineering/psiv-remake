<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<RootNamespace>Psiv.Session</RootNamespace>
		<!-- Where `make` in bindings/ puts the shared library. Override to ship another build. -->
		<PsivNativeDir Condition="'$(PsivNativeDir)' == ''">$(MSBuildThisFileDirectory)../../build/</PsivNativeDir>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(PsivNativeDir)libpsiv_session.dylib" Condition="Exists('$(PsivNativeDir)libpsiv_session.dylib')" Link="libpsiv_session.dylib" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(PsivNativeDir)libpsiv_session.so" Condition="Exists('$(PsivNativeDir)libpsiv_session.so')" Link="libpsiv_session.so" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(PsivNativeDir)psiv_session.dll" Condition="Exists('$(PsivNativeDir)psiv_session.dll')" Link="psiv_session.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
